# ========================================
# # ========================================
# 1) MODELS — store large ones in Google Drive
# ========================================

# Ignore all model file formats by default
*.h5
*.pkl
*.joblib
*.npy
*.npz
*.ckpt
*.pb
*.tflite
*.onnx
*.sav

# Ignore TensorFlow/PyTorch artifacts
**/checkpoint
**/checkpoints
**/saved_model/
**/variables/
**/logs/

# Ignore model directories
models/
artifacts/
output/

# === ALLOW small config/model files ===
!models/feature_names.pkl
!models/iso_reg.pkl
!models/scaler.pkl
!models/y_test.npy

# ========================================
# 2) DATASETS — store these only in Google Drive
# ========================================
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.json
*.zip
*.gz

# Allow this specific JSON file to be tracked
!best_threshold.json

# ========================================
# 3) PYTHON CACHE & TEMP FILES
# ========================================
__pycache__/
*.py[cod]
*.so
*.ipynb_checkpoints

# ========================================
# 4) ENVIRONMENT FILES
# ========================================
.env
.venv/
env/
venv/
*.bak

# ========================================
# 5) OS & EDITOR FILES
# ========================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ========================================
# 6) BACKUP GIT REPOS — never commit these
# ========================================
repo-full-backup.git/
temp-repo.git/
*.git/

# ========================================
# 7) ALLOWLIST — keep these in Git even if inside ignored dirs
# ========================================
!streamlit_app/**
!custom_layers/**
!requirements.txt
!.gitignore
!.gitattributes
!README.md
!LICENSE
!predict_new_data_2/**
!runtime/**
!new_text/**
!best_threshold
!compressed/streamlit_app/**
